// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      @default(0)
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Clerk user ID (string type)
  userId    String
  userName  String? // optional, can store user name
  userImage String? // optional, Clerk profile image if you want

  // Relations (only one will be filled for each review)
  placeId Int?
  place   Place? @relation(fields: [placeId], references: [id])

  activityId Int?
  activity   Activity? @relation(fields: [activityId], references: [id])

  itineraryId Int?
  itinerary   Itinerary? @relation(fields: [itineraryId], references: [id])

  accommodationId Int?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id])

  religiousSiteId Int?
  religiousSite   ReligiousSite? @relation(fields: [religiousSiteId], references: [id])

  cafeId Int?
  cafe   Cafe? @relation(fields: [cafeId], references: [id])

  @@unique([userId, placeId])
  @@unique([userId, activityId])
  @@unique([userId, religiousSiteId])
  @@unique([userId, cafeId])
  @@unique([userId, itineraryId])
  @@unique([userId, accommodationId])
}

model Place {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String // Short summary for "About" section
  history     String? // Longer background/history
  bestTime    String? // e.g. "October - March"
  location    String? // City/District/Province
  latitude    Float?
  longitude   Float?
  highlights  String[] // ["Adventure Sports", "Lakeside Walks", "Temples"]
  tips        String? // Travel tips
  howToReach  String? // Transport guide
  images      String[]

  // Relations
  activities     Activity[]
  accommodations Accommodation[]
  cafes          Cafe[]
  itineraries    Itinerary[]
  religiousSites ReligiousSite[]
  blogs          Blog[]

  reviews Review[]
}

model Activity {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String // Long overview
  shortIntro  String? // Short 1–2 sentence summary
  images      String[]
  gallery     String[]
  videoUrl    String? // Optional YouTube or embed link
  latitude    Float?
  longitude   Float?

  difficulty    String? // Easy, Moderate, Hard
  duration      String? // e.g. "30 minutes flight", "Half-day", etc.
  bestSeason    String? // e.g. "October–April"
  altitudeRange String? // e.g. "1,400m – 2,100m"
  ageLimit      String? // e.g. "Minimum 10 years"

  highlights   String[] // Key features of the activity
  inclusions   String[] // Included in the activity
  exclusions   String[] // Not included
  safetyNotes  String[] // Safety or precaution info
  equipment    String[] // Required or provided equipment
  requirements String[] // Fitness, documents, age, etc.
  faq          Json? // [{question, answer}]
  reviews      Review[]

  bookingInfo        String?
  basePrice          Float?
  currency           String  @default("NPR")
  priceTiers         Json? // [{label:"Adult", price:8000}, {label:"Child", price:5000}]
  cancellationPolicy String?

  // Relations
  itineraries Itinerary[] @relation("ActivityItineraries") // Each activity can have multiple itineraries
  placeId     Int?
  place       Place?      @relation(fields: [placeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Itinerary {
  id                 Int      @id @default(autoincrement())
  name               String
  title              String
  tagline            String?
  slug               String   @unique
  description        String
  images             String[]
  gallery            String[]
  durationDays       Int
  durationNights     Int
  difficulty         String?
  languages          String[]
  highlights         String[]
  inclusions         String[]
  exclusions         String[]
  meetingPoint       String?
  endPoint           String?
  pickupIncluded     Boolean  @default(false)
  whatToBring        String[]
  safetyNotes        String[]
  basePrice          Float
  currency           String   @default("NPR")
  pricingTiers       Json?
  seasonalRates      Json?
  availableMonths    String[]
  minGroupSize       Int?     @default(1)
  maxGroupSize       Int?     @default(24)
  bookingCutoffHrs   Int?     @default(24)
  cancellationPolicy String?
  faq                Json?
  reviews            Review[]

  // Relations
  days       ItineraryDay[]
  departures Departure[]
  placeId    Int?
  place      Place?         @relation(fields: [placeId], references: [id])
  activities Activity[]     @relation("ActivityItineraries")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItineraryDay {
  id            Int      @id @default(autoincrement())
  dayNumber     Int
  title         String
  summary       String
  activities    String[]
  meals         Json?
  accommodation String?
  transport     String?
  images        String[]
  mapPoints     Json?

  itineraryId Int
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id])
}

model Departure {
  id               Int      @id @default(autoincrement())
  date             DateTime
  startTime        String?
  status           String   @default("OPEN") // OPEN / FULL / CLOSED / CANCELLED
  seatsTotal       Int
  seatsAvailable   Int
  priceOverride    Float?
  notes            String?
  isInstantConfirm Boolean  @default(true)

  itineraryId Int
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Traveler {
  id               Int     @id @default(autoincrement())
  fullName         String
  age              Int?
  gender           String?
  nationality      String?
  passportNo       String?
  dietaryNeeds     String?
  medicalNotes     String?
  emergencyContact Json? // { name, phone, relation }

}

model Booking {
  id              Int           @id @default(autoincrement())
  userId          String?        // Clerk user ID
  userName        String?
  userEmail       String?
  userPhone       String?

  fullName        String
  email           String
  phone           String
  
  accommodationId Int
  roomId          Int?          // Optional if user selects a specific room
  checkInDate     DateTime
  checkOutDate    DateTime
  guests          Int
  message         String?       // Optional user note
  status          BookingStatus @default(pending)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])
  room            Room?         @relation(fields: [roomId], references: [id])
}

enum BookingStatus {
  pending
  approved
  rejected
}




model Accommodation {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  description      String
  shortDescription String? // For cards or previews
  images           String[]
  price            Float? // Starting price per night
  discountPrice    Float? // Optional discounted rate
  currency         String?  @default("USD")
  latitude         Float?
  longitude        Float?

  // Categorization
  type         String? // e.g., "Resort", "Hotel", "Guesthouse", "Homestay", "Hostel"
  starCategory Int? // e.g., 3, 4, 5
  reviews      Review[]

  // Detailed Information
  amenities     String[] // WiFi, Pool, etc.
  roomTypes     String[] // Deluxe, Standard, Family Suite
  checkInTime   String?  @default("14:00")
  checkOutTime  String?  @default("12:00")
  contactNumber String?
  email         String?
  website       String?
  address       String?
  city          String?
  postalCode    String?
  mapLink       String?

  // Policies
  cancellationPolicy String? // Description of cancellation/refund
  childPolicy        String? // Child stay policy
  petPolicy          String? // Pet allowance

  // Additional Details
  highlights        String[] // e.g. ["Lakeside view", "Free breakfast"]
  services          String[] // e.g. ["Room Service", "Laundry", "24h Reception"]
  accessibility     String[] // e.g. ["Wheelchair accessible", "Elevator"]
  nearbyAttractions String[] // e.g. ["Phewa Lake", "World Peace Pagoda"]

  // Relations
  placeId Int?
  place   Place? @relation(fields: [placeId], references: [id])

  // Future Relations
  rooms Room[] // For detailed room listings (optional, future)
  booking Booking[]
}

model Room {
  id              Int           @id @default(autoincrement())
  accommodationId Int
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])
  name            String
  description     String?
  images          String[]
  pricePerNight   Float
  maxGuests       Int?
  bedType         String? // e.g. "Queen", "Twin", "King"
  amenities       String[]
  available       Boolean       @default(true)
  booking         Booking[]
}

model ReligiousSite {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String   @unique
  description       String
  location          String
  latitude          Float?
  longitude         Float?
  history           String?
  significance      String?
  openingHours      String?
  entryFee          Json? // { internal, external, notes }
  dressCode         String?
  photography       String?
  bestTimeToVisit   String?
  nearbyAttractions Json? // [{ name, description, distance, images[] }]
  facilities        Json? // { parking, restrooms, guide, shops, ... }
  festivals         Json? // [{ name, month, description, images[] }]
  rituals           Json? // [{ name, description, time, images[] }]
  images            String[]
  contactInfo       Json? // { phone, email, website, address }
  accessibility     Json? // { wheelchair, stairsOnly, audioGuide, ramps }
  safetyGuidelines  Json? // [{ rule, description }]
  reviews           Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place   Place? @relation(fields: [placeId], references: [id])
  placeId Int?
}

model Cafe {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String   @unique
  description       String
  images            String[]
  latitude          Float?
  longitude         Float?
  openingTime       String?
  closingTime       String?
  specialties       String[]
  ambiance          String[]
  menu              Json? // store menu items with name, price, image, category
  facilities        Json? // array of facilities
  contactInfo       Json? // phone, email, website, social
  nearbyAttractions Json? // array with name, distance, image
  placeId           Int?
  place             Place?   @relation(fields: [placeId], references: [id])
  reviews           Review[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Blog {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String
  slug      String   @unique
  images    String[]
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placeId Int?
  place   Place? @relation(fields: [placeId], references: [id])
}
